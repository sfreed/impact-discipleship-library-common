rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // 'root' is a superset-of-admin tier (currently identical rights to
    // 'admin' - see AppUserRole/PermissionService.isAdmin/requireAdmin in
    // the manager app for the client/Cloud-Functions mirrors of this same
    // admin-or-root check, which must stay in sync with this one).
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role in ['admin', 'root'];
    }

    // Manager-app CMS staff (any admin or editor - not just admins) always
    // have full read access regardless of book license, same as they always
    // could before licensing existed - they're not reader-app patrons and
    // have no reason to hold a personal book license.
    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    // True only for a caller whose own adminUsers doc has role 'root' -
    // stricter than isAdmin(), which also accepts plain 'admin'. Used to gate
    // the one action reserved for root specifically: assigning the root role
    // to someone (see the adminUsers update rule below and the client/Cloud-
    // Functions mirrors of this same check).
    function isRoot() {
      return signedIn() &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == 'root';
    }

    // Gates the manager-app-only staff screens (Purchases, Users, Impact
    // Groups, Events) to admin/root, while leaving reader-app patrons
    // (who have no adminUsers doc at all, so isStaff() is false for them)
    // completely unaffected - collections like discussionGroups are read by
    // both apps, so the gate can't just be isAdmin() outright without also
    // locking out every reader-app patron.
    function canAccessStaffOnlyArea() {
      return !isStaff() || isAdmin();
    }

    // The reader app's access gate: does the
    // signed-in patron's own libraryUsers record (keyed by their Auth email -
    // see LibraryUserService) list this book as licensed? See
    // LibraryUser.licensedBookIds's doc comment for why this is a flat array
    // rather than checking into `bookLicenses`' array-of-objects shape
    // (Firestore rules can't query into array-of-object fields).
    function hasBookLicense(bookId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/libraryUsers/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/libraryUsers/$(request.auth.token.email)).data.get('revoked', false) != true &&
        bookId in get(/databases/$(database)/documents/libraryUsers/$(request.auth.token.email)).data.licensedBookIds;
    }

    // An overseas patron - their own libraryUsers doc carries the sticky
    // `internationalUser: true` marker, stamped by the reader app's
    // LibraryUserService.recordLogin the first time an IP geolocation lookup
    // at session entry resolves outside the US (never unset by a later US
    // login; only staff editing the doc can clear it). International patrons
    // read every book free of charge - the reader app also hides its Store
    // and group-license purchasing UI for them, so they're never asked to
    // pay. Trust model is deliberately client-side (the reader app both
    // detects the location and writes the flag to the caller's own doc,
    // which the libraryUsers rule already permits) - accepted the same way
    // the purchases rule accepts client-reported amounts: this gates
    // honest-path UX, not a determined spoofer. Like hasBookLicense, this
    // only reads the CALLER's own doc (no resource fields), so it's safe in
    // list-query rules - an unconstrained units/lessons query from an
    // international patron is provably allowed.
    // Both this and hasBookLicense above also require the caller's doc not to
    // carry the admin-set `revoked` flag (see the libraryUsers rule below) -
    // the flag's primary enforcement is the Auth account being disabled
    // (setLibraryUserRevoked Cloud Function), but a revoked user's existing
    // ID token stays valid for up to an hour; this check closes book-content
    // access inside that window. Free for evaluation cost: both functions
    // already get() this same doc, and rules cache identical document
    // accesses within a single request.
    function isInternationalPatron() {
      return signedIn() &&
        exists(/databases/$(database)/documents/libraryUsers/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/libraryUsers/$(request.auth.token.email)).data.get('revoked', false) != true &&
        get(/databases/$(database)/documents/libraryUsers/$(request.auth.token.email)).data.get('internationalUser', false) == true;
    }

    function canReadBook(bookId) {
      return isStaff() || isInternationalPatron() || hasBookLicense(bookId);
    }

    match /series/{seriesId} {
      allow read: if signedIn();
      // Content authoring is manager-app staff only - same isStaff()
      // interim fix as books/units/lessons below. No reader-app code path
      // writes here (read-only), so this is a no-op for legitimate use and
      // closes a patron-write loophole that existed only by omission.
      allow write: if isStaff();
    }

    // Read is intentionally NOT license-gated (unlike units/lessons below) -
    // the Discussion Groups feature needs any signed-in patron to be able to
    // see any book's title/description regardless of license, to browse and
    // create groups around books they don't yet own. This only exposes
    // metadata; actual lesson content stays fully gated below. Same openness
    // `series` already has.
    match /books/{bookId} {
      allow read: if signedIn();
      // Content authoring is manager-app staff only - a reader-app patron
      // (any signedIn() account) has no legitimate reason to write here.
      // Interim fix: any staff member (admin or editor), not per-node scoped -
      // see PermissionService's own doc comment, that finer-grained model is
      // deliberately client-only today and isn't mirrored here yet.
      allow write: if isStaff();
    }

    match /units/{unitId} {
      allow read: if canReadBook(resource.data.bookId);
      // Same isStaff() interim fix as books above.
      allow write: if isStaff();
    }

    match /lessons/{lessonId} {
      // bookId is denormalized directly onto the lesson doc (see
      // LibraryService.createLesson/ImportBookService) instead of being
      // looked up via the parent unit - same cheap pattern `units` above
      // already uses one level up, avoiding an extra get() on every single
      // lesson read (the highest-traffic read path in the whole system).
      // Every lesson has bookId as of the 2026-08-15
      // scripts/backfill-lesson-bookid.js run - do not revert this to the
      // get()-based check without re-running that backfill first.
      allow read: if canReadBook(resource.data.bookId);
      // Same isStaff() interim fix as books above.
      allow write: if isStaff();

      // Left signedIn()-only rather than license-gated too: a lesson's own
      // rule above already keeps an unlicensed patron from ever discovering
      // a lessonId to query translations for, so this is unreachable from
      // the reader app's own UI for content the requester can't already see
      // the parent lesson of. Known, accepted gap for a determined
      // id-guessing attacker.
      match /translations/{translationId} {
        allow read, write: if signedIn();
      }
    }

    // Collection-group read only (write still goes through the nested rule
    // above) - lets the node-translation dialog build its list of "languages
    // already used somewhere in this library" via a single collectionGroup
    // query across every lesson's translations subcollection, instead of
    // fetching every lesson individually.
    match /{path=**}/translations/{translationId} {
      allow read: if signedIn();
    }

    // Staff-authoring artifacts only - the reader app never reads these, so
    // there's no reason to leave them open to any signed-in patron. Same
    // isStaff() interim fix as books/units/lessons above.
    match /subtemplates/{subtemplateId} {
      allow read, write: if isStaff();
    }

    match /lessonTemplates/{lessonTemplateId} {
      allow read, write: if isStaff();
    }

    // Staff-configured bulk-purchase discount tiers (Config screen, manager
    // app) - any signed-in patron needs to read these to price a group
    // leader's license purchase, but only admin/root can manage them. Doc id
    // is String(numberOfBooks), enforcing "numberOfBooks must be unique" for
    // free - no separate check needed here.
    match /bulkDiscountTiers/{tierId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // A group leader's purchased-but-not-necessarily-assigned book licenses
    // (see the reader app's group-license.model.ts doc comment for the full
    // ownership model). Every mutation happens server-side, via the
    // purchaseGroupLicenses/assignGroupLicense/revokeGroupLicense Cloud
    // Functions (Admin SDK) - none of the authorization here (is this really
    // the leader's own group, is the recipient an approved member, has the
    // group since closed or changed book) can be expressed as a client-side
    // write rule, so client writes are blocked outright.
    match /groupLicenses/{licenseId} {
      allow read: if signedIn() &&
        (resource.data.leaderEmail == request.auth.token.email.lower()
         || resource.data.assignedToEmail == request.auth.token.email.lower()
         || isAdmin());
      allow write: if false;
    }

    // A leader's email invitation to a specific person for an invite-only
    // discussion group - see the reader app's GroupInvite model. Create/
    // cancel are safe as direct client writes (the leader only ever writes
    // a doc about themselves that grants no privilege by itself - the
    // get()-checked conditions below mirror the same idiom the members
    // subcollection above already uses for its creator-approved case).
    // Everything an anonymous, not-yet-signed-in invitee needs (previewing
    // the invite, declining it) and every status transition with a real
    // side effect (accepting - joins the group, maybe grants a license) go
    // through the getInviteDetails/declineGroupInvite/acceptGroupInvite
    // Cloud Functions instead, since an anonymous caller has no auth token
    // for any rule here to check against.
    match /groupInvites/{inviteId} {
      allow read: if signedIn() &&
        (resource.data.leaderEmail == request.auth.token.email.lower() || isAdmin());
      allow create: if signedIn() &&
        request.resource.data.leaderEmail == request.auth.token.email.lower() &&
        request.resource.data.status == 'pending' &&
        get(/databases/$(database)/documents/discussionGroups/$(request.resource.data.groupId)).data.creatorEmail == request.auth.token.email.lower() &&
        get(/databases/$(database)/documents/discussionGroups/$(request.resource.data.groupId)).data.groupVisibility == 'invite-only';
      // "Cancel" = delete-your-own-not-yet-answered invite - once accepted/
      // declined it's kept as a historical record, same posture this file
      // gives rejected join requests above.
      allow delete: if signedIn() &&
        resource.data.leaderEmail == request.auth.token.email.lower() && resource.data.status == 'pending';
      // No client update path at all - status only ever moves via the
      // Cloud Functions above.
      allow update: if false;
    }

    // Content authoring (title/common translations, lesson images) is
    // manager-app staff only - same isStaff() interim fix as books/units/
    // lessons/series above. The reader app only ever reads these (see
    // TitleTranslationService/CommonTranslationService/lesson-image-queries),
    // so this closes a patron-write loophole with no functional change for
    // legitimate use.
    match /titleTranslations/{titleTranslationId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /commonTranslations/{commonTranslationId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // Content-addressed image blobs referenced from lesson/subtemplate HTML by
    // id (`lessonimage:{id}`) instead of embedding base64 inline - keeps a
    // single lesson/translation document well under Firestore's 1MB cap even
    // when it has several images. See LessonImageService.
    match /lessonImages/{imageId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /adminUsers/{uid} {
      // A signed-in user may always read their OWN doc (staff or not - this is
      // what StaffService.isStaff() relies on to tell the two apart, reading
      // `adminUsers/{their-own-uid}` and checking whether it exists; a bare
      // isStaff()-only rule would turn "doesn't exist" into a permission-denied
      // error for every non-staff caller instead). Reading anyone else's doc
      // requires being staff - otherwise this was the entire staff roster
      // (emails/names/roles) readable by any patron.
      // Reading the FULL roster (the Users screen) is admin/root only -
      // editors never see who else has access. A signed-in user may still
      // always read their OWN doc regardless of role (Settings page,
      // StaffService.isStaff()'s existence check, etc.).
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Admins/root can update anything, EXCEPT changing role TO OR AWAY FROM
      // 'root' - only an existing root user may promote someone to root, or
      // demote/edit an already-root user's role. A plain admin can still
      // freely edit a root user's other fields (displayName, etc.) as long as
      // the role itself isn't part of the change, and can freely toggle
      // between 'admin'/'editor' for anyone who isn't currently root. Without
      // the resource.data.role != 'root' guard on the "no role change" and
      // "admin<->editor" branches below, a plain admin could demote an
      // existing root user to 'editor' in one write (root-assignment was
      // guarded, but root-*removal* wasn't - see fix commit for the finding).
      // A signed-in user may also update their OWN doc, but only to touch this
      // exact allowlist of low-stakes self-service fields (personal theme
      // preferences, last-login stamp) - role/permissions must stay
      // admin-only so a non-admin can never self-promote or grant themself
      // access by writing their own doc. lightColorTheme/darkColorTheme must
      // stay in sync with whatever fields UserService.updateOwnPreferences
      // actually writes (see its own doc comment) - adding a new self-service
      // field there means updating this allowlist too, not just the client.
      allow update: if (isAdmin() &&
                         (request.resource.data.role == resource.data.role
                          || (request.resource.data.role != 'root' && resource.data.role != 'root')
                          || isRoot()))
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['darkMode', 'lightColorTheme', 'darkColorTheme', 'lastLogin', 'updatedAt', 'updatedBy']));
      // Create/delete happen exclusively through the createUser/deleteUser/
      // bootstrapFirstAdmin Cloud Functions, which use the Admin SDK and bypass
      // these rules entirely - that's what keeps this collection in sync with the
      // actual Firebase Auth accounts. Direct client writes are blocked so that
      // sync can't be bypassed, and so a non-admin can't self-promote by writing
      // their own role.
      allow create, delete: if false;
    }

    // A signed-in user's saved answers for a lesson's Form.io form - see
    // the reader app's SubmissionService (doc id is
    // deterministic, `{lessonId}_{email}`, keyed by `userEmail` field).
    // Scoped to the submission's own owner, plus admins for read (staff
    // reviewing patron responses).
    match /submissions/{submissionId} {
      // `resource == null` (doc doesn't exist yet) must be allowed explicitly:
      // without it, `resource.data.userEmail` errors on a nonexistent doc and
      // the whole read is denied - which broke the reader app's lesson view
      // for any lesson the patron hadn't submitted yet (its getSubmission
      // probe of the deterministic `{lessonId}_{email}` id was denied, and
      // LessonViewComponent treats any read failure as "no access"). Allowing
      // it only reveals that a guessed submission id doesn't exist - same
      // accepted id-guessing gap as lesson translations above; the content of
      // EXISTING submissions stays owner/admin-only.
      allow read: if signedIn() &&
        (resource == null || resource.data.userEmail == request.auth.token.email.lower() || isAdmin());
      allow create, update: if signedIn() &&
        request.resource.data.userEmail == request.auth.token.email.lower();
      allow delete: if signedIn() && resource.data.userEmail == request.auth.token.email.lower();
    }

    // Order-history record for a Store purchase (see StoreComponent and
    // PurchaseService) - digital book(s) bought, coupon used, amounts, and
    // the PayPal receipt id. Read stays broad (any signed-in user - no admin
    // UI exists yet to need narrower access, and nothing currently reads
    // another user's purchases anyway); write is scoped to the requester's
    // own email and made create-only, so a purchase record can't be forged
    // for someone else or tampered with after the fact - a forgeable audit
    // trail undercuts the whole point of keeping one. See the reader app's
    // handoff.md for the still-missing admin-side items.
    // Shape-only guard on a purchase create, same idiom as
    // isValidErrorLogEntry() below - this is audit-trail INTEGRITY (a
    // malformed/absurd record can't be written), not proof-of-payment.
    // Nothing here verifies the reported amounts against what PayPal
    // actually charged (a deliberate, accepted gap shared with the Cloud
    // Functions' own purchaseGroupLicenses - see that function's doc
    // comment in the manager app's functions/src/index.ts).
    function isValidPurchaseEntry() {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.cartItems is list
        && request.resource.data.cartItems.size() > 0 && request.resource.data.cartItems.size() <= 50
        && request.resource.data.subtotal is number && request.resource.data.subtotal >= 0
        && request.resource.data.discount is number && request.resource.data.discount >= 0
        && request.resource.data.total is number && request.resource.data.total >= 0
        && request.resource.data.receipt is string
        && !('revocations' in request.resource.data);
    }

    match /purchases/{purchaseId} {
      // Read is manager-app-admin-only (the Purchases screen) - the reader
      // app only ever creates these (audit trail) and never reads them back
      // (see PurchaseService), so there's no patron-read need to preserve
      // here the way discussionGroups has.
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.email == request.auth.token.email.lower()
        && isValidPurchaseEntry();
      allow update, delete: if false;
    }

    // A library patron's profile (name/email/phone/book licenses), imported
    // from the legacy impactdisciples-a82a8 project - see the reader app's
    // scripts/backfill-users.js and the LibraryUser model. Deliberately a
    // separate collection from `users` above: that one is Cloud-Functions-
    // provisioned CMS staff (admin/editor), keyed by Firebase Auth uid, with
    // tightly restricted writes.
    //
    // Write is scoped to the requester's own email - every writer in this
    // codebase (recordLogin, updateOwnPreferences, grantBookLicenses,
    // SubmissionService's lessonStatus write, LessonHighlightService) already
    // only ever targets its own signed-in user's doc, so this doesn't break
    // any legitimate path; it closes an actual gap where any signed-in
    // patron could otherwise write directly to another patron's
    // licensedBookIds from devtools, self-granting a paid book for free with
    // no PayPal/coupon involved at all. `.lower()` because the client always
    // normalizes the doc id to lowercase (LibraryUserService.userRef) but
    // Firebase Auth doesn't guarantee the token's email claim is lowercased.
    // Read stays broad (signedIn()) - unlike write, an unscoped read isn't
    // itself the risk here.
    // The owner's write is additionally barred from touching the admin-set
    // revoke fields (`revoked`/`revokedAt`/`revokedBy`, stamped only by the
    // setLibraryUserRevoked Cloud Function via the Admin SDK) - without that
    // carve-out, a revoked user whose ID token hadn't expired yet could
    // simply write `revoked: false` back onto their own doc from devtools.
    // No legitimate reader-app writer touches those keys, so this breaks no
    // existing path.
    match /libraryUsers/{email} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.token.email.lower() == email
        && !request.resource.data.keys().hasAny(['revoked', 'revokedAt', 'revokedBy']);
      allow update: if signedIn() && request.auth.token.email.lower() == email
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['revoked', 'revokedAt', 'revokedBy']);
      allow delete: if signedIn() && request.auth.token.email.lower() == email;

      // "Has this lesson been submitted, and when" markers - see
      // LessonSubmissionStatus model and SubmissionService.saveSubmission.
      // Rules don't apply recursively to subcollections, so this needs its
      // own nested match even though it sits under a path already covered
      // above - same own-email scoping as the parent, same reasoning.
      match /lessonStatus/{lessonId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.token.email.lower() == email;
      }

      // A signed-in user's own highlighted lesson-content quotes - see
      // the reader app's LessonHighlight model and
      // LessonHighlightService. One doc per (user, lesson), array of
      // highlight records - same "own nested match" requirement as
      // lessonStatus above, same own-email scoping as the parent.
      match /lessonHighlights/{lessonId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.token.email.lower() == email;
      }

      // Per-device FCM registration tokens - written by the reader app's
      // PushNotificationService, read by the manager repo's push-notification
      // Cloud Function triggers (Admin SDK, bypasses these rules). Unlike the
      // sibling subcollections above, READ is owner-only too: a push token is
      // a capability handle (anyone holding it can address that device via
      // any FCM-enabled server key), so the parent doc's broad signedIn()
      // read must not extend to it.
      match /fcmTokens/{tokenId} {
        allow read, write: if signedIn() && request.auth.token.email.lower() == email;
      }

      // Admin-sent announcements, fanned out one doc per recipient by the
      // manager repo's sendLibraryUserMessage Cloud Function (Admin SDK, the
      // only writer - doc id is the shared adminMessages summary id). READ is
      // owner-only like fcmTokens (a private inbox, not part of the broadly
      // readable parent profile). The owner's permitted mutations: flipping
      // `read` to true (never editing content or un-reading), and deleting a
      // message they have already read - unread ones can't be dismissed
      // unseen, and the adminMessages summary keeps the sent record either
      // way. A deleted message stays gone (create is Function-only) unless
      // the admin re-sends, which recreates the same doc id.
      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.token.email.lower() == email;
        allow update: if signedIn() && request.auth.token.email.lower() == email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
        allow delete: if signedIn() && request.auth.token.email.lower() == email
          && resource.data.read == true;
        allow create: if false;
      }
    }

    // Collection-group read only (write still goes through the nested rule
    // above) - lets a staff diagnostic check "do any saved highlights still
    // resolve after a content edit" run one query across every patron's
    // lessonHighlights, instead of needing to already know every email.
    match /{path=**}/lessonHighlights/{lessonId} {
      allow read: if signedIn();
    }

    // One summary doc per admin broadcast (title/body/recipients/counts),
    // written only by the manager repo's sendLibraryUserMessage Cloud
    // Function (Admin SDK) alongside the per-recipient inbox fan-out above -
    // backs the manager app's sent-messages history screen. Admin-only read;
    // never client-writable.
    match /adminMessages/{messageId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // True only if the caller has an 'approved' membership doc for this
    // specific group - a fixed, non-variable get() lookup, so (unlike
    // checking the QUERIED documents' own fields) this is safe to use for
    // list-query rules too, same idiom as hasBookLicense above. The
    // group's own creator always has one (see DiscussionGroupService.
    // createGroup), so this covers "am I the creator" for free.
    function isApprovedGroupMember(groupId) {
      return signedIn() &&
        get(/databases/$(database)/documents/discussionGroups/$(groupId)/members/$(request.auth.token.email.lower())).data.status == 'approved';
    }

    // A patron-organized book discussion group (in-person and/or online) -
    // see the reader app's DiscussionGroup model and
    // DiscussionGroupService. Any signed-in patron may create one (around
    // any book, not just ones they're licensed for), but only the creator
    // (or staff) may update (e.g. close it) or delete it.
    match /discussionGroups/{groupId} {
      // Reader-app patrons keep unrestricted read (see canAccessStaffOnlyArea's
      // doc comment); manager-app staff need admin/root - editors can't see
      // the admin Impact Groups screen (or its data directly).
      allow read: if signedIn() && canAccessStaffOnlyArea();
      // A group can only be STARTED around a book the creator personally holds a
      // license for (hasBookLicense, not canReadBook - deliberately no staff bypass
      // here, unlike every other license check in this file; the manager app has no
      // group-creation path at all, so this only ever gates reader-app patrons in
      // practice). International patrons (isInternationalPatron - free all-book
      // access, never asked to pay) count as licensed for every book here too,
      // matching the reader app's create-group book picker offering them
      // everything. Editing/deleting an existing group is unaffected - see below.
      allow create: if signedIn() && request.resource.data.creatorEmail == request.auth.token.email.lower() &&
        (hasBookLicense(request.resource.data.bookId) || isInternationalPatron());
      // Deliberately NOT license-gated: updateGroup always writes the full wizard
      // result (including bookId, whether or not it changed), and gating this would
      // mean an admin fixing an unrelated typo on someone else's group would need to
      // personally hold a license for that group's book.
      allow update, delete: if signedIn() &&
        (resource.data.creatorEmail == request.auth.token.email.lower() || isAdmin());

      // One doc per patron who's requested (or been granted) membership,
      // keyed by their own lowercased email - see GroupMembership. A patron
      // may only ever create their OWN doc, and only as 'pending' (an
      // approved/rejected doc can only come from the creator/staff updating
      // an existing request afterward, never a self-written one) - EXCEPT
      // the group's own creator, who writes their own doc straight to
      // 'approved' at group-creation time (see
      // DiscussionGroupService.createGroup) so "am I a member" never needs a
      // special case for "or did I create it". Delete covers both "withdraw
      // my own request/leave" and "the creator or staff removing a member".
      match /members/{email} {
        // Tightened from "any signed-in patron" (which let anyone enumerate
        // any group's member roster - emails included - just by knowing or
        // guessing a groupId, even for 'invite-only' groups) to: staff
        // admin, or an approved member of THIS group reading via their own
        // membership doc.
        allow read: if signedIn() && (isAdmin() || isApprovedGroupMember(groupId));
        allow create: if signedIn() && email == request.auth.token.email.lower() &&
          (request.resource.data.status == 'pending' ||
           (request.resource.data.status == 'approved' &&
            get(/databases/$(database)/documents/discussionGroups/$(groupId)).data.creatorEmail == email));
        allow update: if signedIn() &&
          (get(/databases/$(database)/documents/discussionGroups/$(groupId)).data.creatorEmail == request.auth.token.email.lower()
           || isAdmin());
        allow delete: if signedIn() &&
          (email == request.auth.token.email.lower()
           || get(/databases/$(database)/documents/discussionGroups/$(groupId)).data.creatorEmail == request.auth.token.email.lower()
           || isAdmin());
      }

      // The group's shared chat - see GroupChatMessage. Only an approved
      // member may post (checked by reading their own membership doc, same
      // technique as hasBookLicense above); no client-side edit/delete of a
      // sent message. Read tightened the same way as members above - chat
      // content is more sensitive than a roster, so "any signed-in user"
      // (reader OR manager, editor included) was a real exposure, not just
      // an accepted client-side-only gate.
      match /chatMessages/{messageId} {
        allow read: if signedIn() && (isAdmin() || isApprovedGroupMember(groupId));
        allow create: if signedIn() &&
          request.resource.data.senderEmail == request.auth.token.email.lower() &&
          request.resource.data.text is string && request.resource.data.text.size() < 4000 &&
          isApprovedGroupMember(groupId);
        allow update, delete: if false;
      }

      // A prayer shared into this group from a lesson's prayer field - see
      // GroupPrayerRequest. Read tightened the same way as members/
      // chatMessages above - shared prayer content is at least as sensitive
      // as chat, so it gets the same isAdmin()-or-approved-member gate
      // rather than "any signed-in user". Delete allowed for the author or
      // the group's creator (its leader) or staff - no client-side edit
      // either way.
      match /prayerRequests/{requestId} {
        allow read: if signedIn() && (isAdmin() || isApprovedGroupMember(groupId));
        allow create: if signedIn() &&
          request.resource.data.authorEmail == request.auth.token.email.lower() &&
          request.resource.data.text is string && request.resource.data.text.size() < 4000 &&
          isApprovedGroupMember(groupId);
        allow delete: if signedIn() &&
          (resource.data.authorEmail == request.auth.token.email.lower()
           || get(/databases/$(database)/documents/discussionGroups/$(groupId)).data.creatorEmail == request.auth.token.email.lower()
           || isAdmin());
        allow update: if false;
      }

      // A 1:1 thread between the group's creator and exactly one other
      // person (an approved member or a rejected/pending requester) - see
      // GroupConversation. Doc id == the other person's lowercased email,
      // so "am I a participant" is just "am I that email, or am I this
      // group's creator" - no participant list to search.
      match /conversations/{otherEmail} {
        allow read, create, update: if signedIn() &&
          (otherEmail == request.auth.token.email.lower()
           || get(/databases/$(database)/documents/discussionGroups/$(groupId)).data.creatorEmail == request.auth.token.email.lower());

        match /messages/{messageId} {
          allow read: if signedIn() &&
            (otherEmail == request.auth.token.email.lower()
             || get(/databases/$(database)/documents/discussionGroups/$(groupId)).data.creatorEmail == request.auth.token.email.lower());
          allow create: if signedIn() &&
            request.resource.data.senderEmail == request.auth.token.email.lower() &&
            (otherEmail == request.auth.token.email.lower()
             || get(/databases/$(database)/documents/discussionGroups/$(groupId)).data.creatorEmail == request.auth.token.email.lower());
          allow update, delete: if false;
        }
      }
    }

    // Collection-group read only - lets "my groups" (see
    // DiscussionGroupService.getMyMemberships) find every group a patron
    // belongs to in one query, instead of needing to already know which
    // groups to check. Also backs the manager app's admin table's unfiltered
    // getAllGroupMemberships (member-count column). Tightened the same way
    // as the nested members rule above: isAdmin() (satisfies the manager
    // app's unfiltered query unconditionally) OR the document is literally
    // the caller's own membership doc - getMyMemberships already filters
    // `where('email', '==', callerEmail)`, so Firestore can prove this rule
    // holds for every possible result of that exact query shape.
    match /{path=**}/members/{email} {
      allow read: if signedIn() && (isAdmin() || resource.data.email == request.auth.token.email.lower());
    }

    match /activityLog/{entryId} {
      // Account/access events plus library content add/edit/delete - see
      // ActivityLogService/ActivityLogEntry. Reading the log (the Events
      // screen, and the per-user activity column on the Users detail page)
      // is admin/root only - editors can't see anyone's activity, including
      // their own, through this collection. Writing stays open to any
      // signed-in staff member recording their OWN actions (an editor's
      // edits still need to show up in the log for an admin to audit) -
      // there is no update path, entries are never edited, only (by an
      // admin, from the Events screen) removed outright.
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.actorUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Basic type/size bounds on a logged error entry - the pre-auth create
    // path below needs no signed-in identity at all, so without this an
    // anonymous caller could write arbitrarily many docs with unbounded
    // message/stack strings (storage-cost flooding) or a fabricated
    // userEmail attributing a fake "failed login" to any real patron
    // (log-poisoning of what root sees on the Error Logs screen). Bounds
    // are generous, not exact - this is abuse prevention, not strict schema
    // validation.
    function isValidErrorLogEntry() {
      return request.resource.data.message is string && request.resource.data.message.size() < 2000
        && request.resource.data.location is string && request.resource.data.location.size() < 200
        && (!('detail' in request.resource.data) || (request.resource.data.detail is string && request.resource.data.detail.size() < 2000))
        && (!('stack' in request.resource.data) || (request.resource.data.stack is string && request.resource.data.stack.size() < 8000))
        && (!('userEmail' in request.resource.data) || request.resource.data.userEmail == null
            || (request.resource.data.userEmail is string && request.resource.data.userEmail.size() < 320));
    }

    match /errorLogs/{entryId} {
      // Every logged client/Cloud-Function error - see ErrorLogEntry and
      // BaseErrorLogHandler. Read/delete is root-only - stricter than
      // activityLog (isAdmin()): even a plain admin doesn't see this.
      //
      // Two create paths:
      //  1. A signed-in user (either app, any role) logging their OWN error,
      //     self-attributed the same way activityLog is.
      //  2. A FAILED LOGIN, SIGNUP, OR FORGOT-PASSWORD ATTEMPT - the one
      //     deliberate exception to "must be signed in to write" anywhere in
      //     this whole rules file. Tightly scoped: uid must be null,
      //     location must be exactly 'login', 'signup', or
      //     'forgotPassword', app must be one of the two real client apps.
      //     This can't be used to write anything else - every other field
      //     combination still requires signedIn(). See
      //     BaseErrorLogHandler.logPreAuthFailure, the only code path that
      //     produces this shape.
      //
      // `app` is constrained to the two CLIENT-writable values in both
      // paths - a 'functions'-sourced entry can only come from the Cloud
      // Functions' Admin SDK write, which bypasses these rules entirely, so
      // a client could otherwise spoof one.
      allow read, delete: if isRoot();
      allow create: if isValidErrorLogEntry() &&
        ((signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.app in ['reader', 'manager'])
         || (!signedIn() && request.resource.data.uid == null
             && request.resource.data.app in ['reader', 'manager']
             && request.resource.data.location in ['login', 'signup', 'forgotPassword']));
      // Repeat suppression (see BaseErrorLogHandler): a rapidly-recurring
      // error updates its episode's FIRST entry instead of creating one doc
      // per occurrence. The only mutation ever allowed, and only on the
      // author's own entries: exactly repeatCount + lastOccurredAt, count
      // monotonically increasing, last-seen never before the entry's own
      // start. Everything else (message, stack, attribution) stays
      // immutable, preserving the log's audit integrity. Pre-auth (uid ==
      // null) entries have no update path at all.
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repeatCount', 'lastOccurredAt'])
        && request.resource.data.repeatCount is int
        && request.resource.data.repeatCount >= 2
        && (!('repeatCount' in resource.data) || request.resource.data.repeatCount >= resource.data.repeatCount)
        && request.resource.data.lastOccurredAt is int
        && request.resource.data.lastOccurredAt >= resource.data.timestamp;
    }
  }
}
